{
  "name": "sendpository",
  "version": "0.5.0",
  "description": "Official Node.js and TypeScript client for the Sendpository transactional email API.",
  "keywords": [
    "email",
    "transactional-email",
    "email-api",
    "api",
    "sendpository",
    "mailer",
    "send-email",
    "dkim",
    "webhooks",
    "typescript",
    "ai-agents",
    "claude-code",
    "agent-skills"
  ],
  "homepage": "https://sendpository.com/docs/guides/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sendpository/sendpository-node.git"
  },
  "bugs": {
    "url": "https://github.com/sendpository/sendpository-node/issues",
    "email": "support@sendpository.com"
  },
  "license": "MIT",
  "author": "Sendpository <support@sendpository.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sendpository": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "agents",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "sync:skill": "node scripts/sync-skill.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
